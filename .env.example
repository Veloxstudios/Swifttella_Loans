DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=generate-with-cryptography-fernet
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
DATABASE_URL=postgres://user:pass@host:5432/db
LENDER_NAME=Swiftella Loans
LENDER_ADDRESS=Registered office address, United Kingdom
LENDER_FCA_NUMBER=
LENDER_EMAIL=support@example.com

# Customer emails (any SMTP provider). Leave EMAIL_HOST blank to send nothing.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Swiftella Loans <no-reply@yourdomain.co.uk>

# Main website the header and footer link to
MAIN_SITE_URL=https://easy-pay-loan-production.up.railway.app

# Compliance details (see COMPLIANCE.md)
LENDER_COMPANY_NUMBER=
LENDER_ICO_NUMBER=
PRICE_COMPARISON_URL=
PRICE_COMPARISON_NAME=
DATA_RETENTION_DAYS=365
AFFORDABILITY_BUFFER_PENCE=10000
# Security
TRUSTED_PROXIES=1
SESSION_IDLE_SECONDS=1800
APPLY_RATE_LIMIT=5
LOGIN_MAX_FAILURES=5
